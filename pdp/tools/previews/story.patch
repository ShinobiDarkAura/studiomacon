+#!/usr/bin/env python3
+"""Generate the story-collage image library for the nine totems through Codex, two at a time.
+Skips anything already made, so it can be re-run to fill gaps.
+
+    python3 pdp/_variant-story/pdp/gen_library.py
+"""
+import os, subprocess, sys
+from concurrent.futures import ThreadPoolExecutor
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+O = os.path.join(HERE, "img", "story")
+GEN = os.path.join(O, "gen")
+M = os.path.join(HERE, "img", "moodboard", "museum")
+CODEX = os.path.expanduser("~/.claude/skills/codex-imagegen/scripts/gen.py")
+
+TOTEMS = {  # name; what lies beside it in the cyanotype (varied objects, from its story)
+    "pip": ("Pip", "a small old key, a single shirt button, a loose loop of thread and a sprig of lavender"),
+    "rebi": ("Rebi", "a four-leaf clover, a small coin, a loose loop of thread and a fern frond"),
+    "ren": ("Ren", "an oak leaf, an acorn, a small compass and a short twig"),
+    "zuma": ("Zuma", "a small spiral shell, a smooth pebble, a coil of string and a sprig of sage"),
+    "milo": ("Milo", "a wheat stalk, a small feather, a button and a length of twine"),
+    "yael": ("Yael", "a feather, a tiny bell, a short ribbon and a fern frond"),
+    "ori": ("Ori", "a maple leaf, an acorn, a small key and a pine twig"),
+    "ibi": ("Ibi", "a long feather, a slender reed, a scrap of lace and a small coin"),
+    "eleph": ("Eleph", "a ginkgo leaf, a loop of string, a small button and a pressed flower"),
+}
+PH = ("a Talbot photogenic drawing, a salted-paper negative from about 1840: warm brown, uneven, mottled sensitised paper "
+      "with soft darker edges and a few small specks, the object recorded as a pale cream trace by light alone.")
+
+
+def jobs():
+    for s, (name, things) in TOTEMS.items():
+        yield (f"{s}-photogenic3.png", [f"{O}/{s}-neg-ref.png", f"{O}/{s}-grey-ref.jpg", f"{M}/wc-william-henry-fox-talbot-leaf-study-1839.jpg"],
+               f"Make a single portrait 4:5 print in the style of the THIRD reference image: {PH} The subject is the small bronze totem '{name}' "
+               "(photographed in the SECOND reference). Copy its outline EXACTLY from the FIRST reference image (same silhouette and proportions, "
+               "clean edges, nothing added), but SMALL: the figure is only about a quarter of the sheet's height, centred on the sheet, with "
+               "lots of empty paper around it, and only faint soft inner tonal detail. At the BOTTOM RIGHT corner, quick, loose, gestural, barely "
+               f"legible handwritten notes in PALE CREAM-WHITE (light on the brown paper, like chalk or white pencil), three short lines: '{name}', "
+               "'solid bronze', 'carved by hand'. No numbers, no measurements, no scale bar, no other text, no borders.", "1024x1280")
+        yield (f"{s}-note3.png", [f"{O}/{s}-grey-ref.jpg", f"{O}/{s}-grey-ref2.jpg"],
+               "A small, plain, slightly worn off-white index card (one torn edge), photographed flat from directly above on a perfectly flat, "
+               "evenly lit pure green background (#00FF00) with NO shadow on the green. On the card, three light, quick graphite pencil OUTLINE "
+               "sketches of the same small totem shown in the two reference photos, seen from three different angles (for example the side, "
+               "the other side and the front), drawn small, side by side in a loose row with space around them: contour lines only, NO shading, "
+               "NO hatching, NO text, NO numbers, NO labels. Keep each drawing true to the totem's real shape. Landscape card, no logos.", "1280x896")
+
+
+def run(job):
+    out, refs, prompt, size = job
+    dst = os.path.join(GEN, out)
+    if os.path.exists(dst):
+        return f"skip {out}"
+    args = [sys.executable, CODEX, prompt, "-o", dst, "--size", size]
+    for r in refs:
+        args += ["-i", r]
+    r = subprocess.run(args, capture_output=True, text=True)
+    return f"{'ok  ' if os.path.exists(dst) else 'FAIL'} {out} {'' if os.path.exists(dst) else (r.stdout + r.stderr)[-200:]}"
+
+
+if __name__ == "__main__":
+    os.makedirs(GEN, exist_ok=True)
+    with ThreadPoolExecutor(2) as ex:
+        for line in ex.map(run, list(jobs())):
+            print(line, flush=True)
