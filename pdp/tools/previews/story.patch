+#!/usr/bin/env python3
+"""Story-section variants on Rebi's and Yael's pages (local preview only; lives in _variant-story).
+
+    python3 pdp/_variant-story/pdp/make_story_lab.py
+Run after this copy's build_pdp.py: it replaces the parked story block in rebi.html and yael.html.
+"""
+import html, json, os, re
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+E = html.escape
+SCALE = json.load(open(os.path.join(HERE, "img", "story", "scale.json")))
+KIN = {"rebi": ("Netsuke of a Seated Hare", "Minkō, 18th–19th century. The Metropolitan Museum of Art, CC0"),
+       "yael": ("Moorhen (Vandhøne)", "François Pompon. SMK, Statens Museum for Kunst, public domain")}
+SIZE = {"rebi": "42 × 16 × 16 mm", "yael": "30 × 22 × 11 mm"}
+
+CSS = """
+<style>
+  .lab{padding:120px 0 40px;border-top:1px solid #eee}
+  .lab-head{max-width:760px;margin:0 auto 40px;padding:0 24px;font:400 13px/1.5 var(--sans);opacity:.6}
+  .v{padding:96px 24px;border-bottom:1px solid #eee}
+  .v-tag{display:block;max-width:1100px;margin:0 auto 36px;font:500 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;opacity:.45}
+  .v-tag b{opacity:1;color:#000;margin-right:10px}
+  .story{font:400 clamp(20px,2vw,26px)/1.45 var(--serif-text, "Instrument Serif", serif);max-width:560px;margin:0}
+  .made{font:400 15px/1.6 var(--sans);opacity:.7;max-width:460px;margin:22px 0 0}
+  .row{display:grid;gap:48px;align-items:center;max-width:1100px;margin:0 auto}
+  .row img{display:block;width:100%;height:auto}
+  .cap{font:400 12px/1.4 var(--sans);opacity:.55;margin:10px 0 0}
+  .r3{grid-template-columns:1fr 1.2fr 1fr}
+  .r2{grid-template-columns:1fr 1fr}
+  .r2-wide{grid-template-columns:1.4fr 1fr}
+  .strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:1100px;margin:0 auto 40px}
+  .strip figure{margin:0}.strip img{aspect-ratio:4/5;object-fit:cover;width:100%;display:block}
+  .strip .n{font:400 11px/1 var(--sans);opacity:.45;margin-top:6px}
+  .record{position:relative;max-width:900px;margin:0 auto}
+  .record img{width:100%;display:block}
+  .record .bar{position:absolute;height:1px;background:#1a1a1a}
+  .record .bar::before,.record .bar::after{content:"";position:absolute;top:-4px;width:1px;height:9px;background:#1a1a1a}
+  .record .bar::before{left:0}.record .bar::after{right:0}
+  .record .lbl{position:absolute;font:400 11px/1 var(--sans);letter-spacing:.04em}
+  .record-text{max-width:1100px;margin:40px auto 0;display:grid;grid-template-columns:1fr 1fr;gap:48px}
+  .ph{aspect-ratio:4/5;border:1px dashed #bbb;display:flex;align-items:center;justify-content:center;text-align:center;
+      font:400 13px/1.5 var(--sans);opacity:.7;padding:24px;background:repeating-linear-gradient(45deg,#fafafa 0 12px,#f4f4f4 12px 24px)}
+  .note{font:400 12px/1.4 var(--sans);opacity:.5;max-width:1100px;margin:18px auto 0}
+  .centered{max-width:640px;margin:0 auto;text-align:center}.centered .story,.centered .made{margin-left:auto;margin-right:auto}
+  .plate{max-width:620px;margin:0 auto 48px}
+  @media (max-width:767px){ .r3,.r2,.r2-wide,.record-text{grid-template-columns:1fr} .strip{grid-template-columns:repeat(2,1fr)} .v{padding:64px 16px} }
+</style>"""
+
+
+def variants(slug, name, lore, made):
+    S = SCALE[slug]
+    t = f'<p class="story">{E(lore)}</p>'
+    m = f'<p class="made">{E(made)}</p>'
+    img = lambda f, alt="": f'<img src="img/story/{f}" alt="{E(alt)}" loading="lazy">'
+    v = []
+    v.append(("Sketch to bronze", "Hannah's charcoal, the story, the bronze it became.",
+              f'<div class="row r3"><div>{img(slug + "-sketch.jpg")}<p class="cap">Charcoal, before the wax</p></div><div>{t}{m}</div>'
+              f'<div>{img(slug + "-grey.jpg")}<p class="cap">Solid bronze</p></div></div>'))
+    shots = [(f"../{slug}/terracotta.jpg.webp", "On suede, afternoon"), (f"../{slug}/hand-2.jpg.webp", "In the hand"),
+             (f"../{slug}/white-1.jpg.webp", "Studio, from the left"), (f"../{slug}/white-2.jpg.webp", "Studio, from the right")]
+    v.append(("A light study", "The same piece, four lights: a loose contact sheet beside the story.",
+              '<div class="strip">' + "".join(f'<figure>{img(f)}<p class="n">{i:02d} · {E(c)}</p></figure>' for i, (f, c) in enumerate(shots, 1)) + "</div>"
+              f'<div class="centered">{t}{m}</div>'))
+    kt, kc = KIN[slug]
+    v.append(("Kin", "One ancestor beside it, captioned plainly.",
+              f'<div class="row r2"><div>{img(slug + "-grey.jpg")}<p class="cap">{E(name)}, solid bronze, 2026</p></div>'
+              f'<div>{img("kin-" + slug + ".jpg")}<p class="cap">{E(kt)}. {E(kc)}</p></div></div>'
+              f'<div class="record-text"><div>{t}</div><div>{m}</div></div>'))
+    bar_w = S["bar_pct_of_width"]; left = S["right_pct"] + 4; top = S["base_pct_from_top"]
+    v.append(("Plain record, to scale", "One photograph, a hairline 10 mm mark and the size. Nothing else.",
+              f'<div class="record">{img(slug + "-grey.jpg")}<span class="bar" style="left:{left}%;top:{top}%;width:{bar_w}%"></span>'
+              f'<span class="lbl" style="left:{left}%;top:calc({top}% + 10px)">10 mm</span>'
+              f'<span class="lbl" style="left:{left}%;top:calc({top}% + 26px);opacity:.55">{E(SIZE[slug])}</span></div>'
+              f'<div class="record-text"><div>{t}</div><div>{m}</div></div>'))
+    v.append(("Wax beside bronze (to shoot)", "Where the carved wax would sit, if the next one is photographed before the foundry.",
+              f'<div class="row r3"><div class="ph">The wax, before casting<br>(photograph to come)</div><div>{t}{m}</div>'
+              f'<div>{img(slug + "-grey.jpg")}<p class="cap">The bronze it became</p></div></div>'))
+    v.append(("In the landscape (to shoot)", "One documentary photograph outside, on moss or stone, nothing added.",
+              f'<div class="row r2-wide"><div class="ph" style="aspect-ratio:3/2">{E(name)} on moss, bark or a creek stone<br>(photograph to come)</div>'
+              f'<div>{t}{m}</div></div>'))
+    v.append(("Object and trace", "The bronze, and the mark it leaves on light-sensitive paper (after the Hatton fern album).",
+              f'<div class="row r2"><div>{img(slug + "-grey.jpg")}<p class="cap">The object</p></div>'
+              f'<div>{img(slug + "-cyanotype-single.jpg")}<p class="cap">Its cyanotype</p></div></div>'
+              f'<div class="record-text"><div>{t}</div><div>{m}</div></div>'))
+    v.append(("A pair of plates", "Two angles on one cyanotype sheet, a pencilled caption at the foot.",
+              f'<div class="plate">{img(slug + "-cyanotype-pair.jpg")}</div><div class="centered">{t}{m}</div>'))
+    v.append(("Photogenic drawing", "Talbot's paper negative: the piece's light and dark reversed, its carving showing like a leaf's veins.",
+              f'<div class="row r2-wide"><div>{img(slug + "-photogenic.jpg")}<p class="cap">{E(name)}, photogenic drawing</p></div><div>{t}{m}</div></div>'))
+    body = "".join(f'<section class="v"><span class="v-tag"><b>{i:02d}</b>{E(n)} · {E(d)}</span>{h}</section>' for i, (n, d, h) in enumerate(v, 1))
+    return (CSS + '<section class="lab"><p class="lab-head">Story section: nine ways to show it (local preview). '
+            'The cyanotypes and the photogenic drawing are digital stand-ins made from the real silhouettes; real ones need paper and sun. '
+            'The dashed frames are photographs still to take.</p>' + body + "</section>")
+
+
+for slug, name in (("rebi", "Rebi"), ("yael", "Yael")):
+    p = os.path.join(HERE, f"{slug}.html"); d = open(p).read()
+    lore = html.unescape(re.search(r'data-edit="lore">(.*?)</p>', d, re.S).group(1))
+    made = html.unescape(re.search(r'data-edit="made">(.*?)</p>', d, re.S).group(1))
+    d = re.sub(r"<!-- lore and making blocks, parked for now.*?-->", lambda _m: variants(slug, name, lore, made), d, count=1, flags=re.S)
+    assert 'class="lab"' in d, slug
+    open(p, "w").write(d)
+    print(slug, "story lab written")
