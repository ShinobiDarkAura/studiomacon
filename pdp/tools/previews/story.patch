+#!/usr/bin/env python3
+"""Turn the generated library into collage pieces (local preview only).
+
+    python3 pdp/_variant-story/pdp/make_pieces.py
+
+- sketch / note: the green ground keyed out, the torn paper kept with clean transparent edges
+- cyano: the totem's exact silhouette laid crisp into the clear space of its leaf sheet, small in the frame
+- photogenic: used as generated (the whole sheet)
+Writes img/story/pieces/<slug>-<kind>.webp and pieces.json (the sizes, for the layout).
+"""
+import glob, json, os
+import numpy as np
+from PIL import Image
+from scipy import ndimage
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+S = os.path.join(HERE, "img", "story")
+GEN, OUT = os.path.join(S, "gen"), os.path.join(S, "pieces")
+SLUGS = "pip rebi ren zuma milo yael ori ibi eleph".split()
+SIL_H, SIL_W = 0.20, 0.26          # the silhouette's largest height and width as shares of the cyanotype sheet
+
+
+def key_green(path):
+    """Cut a paper piece off a flat #00FF00 ground: alpha from how green each pixel is, the green spill removed."""
+    a = np.asarray(Image.open(path).convert("RGB")).astype(float)
+    r, g, b = a[..., 0], a[..., 1], a[..., 2]
+    greenness = g - np.maximum(r, b)
+    alpha = 1 - np.clip((greenness - 25) / 60, 0, 1)
+    solid = ndimage.binary_fill_holes(alpha > .5)
+    lab, k = ndimage.label(solid)
+    solid = lab == (np.argmax(ndimage.sum(solid, lab, range(1, k + 1))) + 1)          # the paper only, no specks
+    alpha = np.where(ndimage.binary_dilation(solid, iterations=2), alpha, 0)
+    alpha = np.where(ndimage.binary_erosion(solid, iterations=3), 1, alpha)          # the paper's inside fully opaque
+    spill = np.clip(g - np.maximum(r, b), 0, None)
+    a[..., 1] = g - spill * (1 - alpha) * 1.0 - np.clip(spill, 0, 30) * .6          # take the green cast off the torn edges
+    rgba = np.dstack([np.clip(a, 0, 255), alpha * 255]).astype(np.uint8)
+    ys, xs = np.where(alpha > .02)
+    return Image.fromarray(rgba).crop((xs.min(), ys.min(), xs.max() + 1, ys.max() + 1))
+
+
+def cyano(slug):
+    """The blue print alone (the white around it and its clipped corners made transparent), the totem's exact silhouette
+    laid crisp in the middle, a few degrees askew, as if set down by hand."""
+    src = np.asarray(Image.open(os.path.join(GEN, f"{slug}-cyano2.png")).convert("RGB")).astype(float)
+    blue = ndimage.binary_opening((src[..., 2] > src[..., 0] + 35) & (src.mean(2) < 200), iterations=2)
+    lab, k = ndimage.label(blue); blue = lab == (np.argmax(ndimage.sum(blue, lab, range(1, k + 1))) + 1)
+    sheet_mask = ndimage.binary_fill_holes(ndimage.binary_closing(blue, iterations=6))          # the sheet, its pale traces included
+    ys, xs = np.where(sheet_mask)
+    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1
+    sheet, alpha = src[y0:y1, x0:x1].copy(), sheet_mask[y0:y1, x0:x1].astype(float)
+    alpha = ndimage.gaussian_filter(alpha, .7)
+    H, W, _ = sheet.shape
+    trace = sheet[(sheet.mean(2) > 170) & (alpha > .99)]
+    white = np.percentile(trace, 90, axis=0) if len(trace) > 50 else np.array([226.0, 234, 240])          # as pale as the brightest of the printed things
+    m = Image.open(os.path.join(S, f"{slug}-mask.png")).convert("L")
+    angle = ((sum(map(ord, slug)) % 13) - 6) * 1.6 or 5          # a different small tilt for each piece, never quite flat
+    m = m.rotate(angle, resample=Image.BICUBIC, expand=True)
+    k0 = min(H * SIL_H / m.height, W * SIL_W / m.width); h, w = int(m.height * k0), int(m.width * k0)
+    mm = np.asarray(m.resize((w * 4, h * 4), Image.LANCZOS).resize((w, h), Image.BOX)).astype(float) / 255          # crisp, antialiased only
+    cy, cx = H // 2, W // 2                                    # centred both ways
+    ty, tx = cy - h // 2, cx - w // 2
+    region = sheet[ty:ty + h, tx:tx + w]
+    grain = 1 + (np.random.default_rng(1).normal(0, .018, mm.shape))[..., None]
+    sheet[ty:ty + h, tx:tx + w] = region * (1 - mm[..., None]) + np.clip(white * grain, 0, 255) * mm[..., None]
+    return Image.fromarray(np.dstack([sheet, alpha * 255]).round().clip(0, 255).astype(np.uint8))
+
+
+if __name__ == "__main__":
+    os.makedirs(OUT, exist_ok=True)
+    sizes = {}
+    for slug in SLUGS:
+        newest = lambda s, k: next((os.path.join(GEN, f"{s}-{k}{v}.png") for v in ("3", "2") if os.path.exists(os.path.join(GEN, f"{s}-{k}{v}.png"))), os.path.join(GEN, f"{s}-{k}2.png"))
+        for kind, make in (("sketch", lambda s: key_green(newest(s, "sketch"))),
+                           ("note", lambda s: key_green(newest(s, "note"))),
+                           ("cyano", cyano),
+                           ("photogenic", lambda s: Image.open(newest(s, "photogenic")).convert("RGB"))):
+            src = newest(slug, kind)
+            if not os.path.exists(src):
+                continue
+            im = make(slug)
+            if max(im.size) > 1800: im.thumbnail((1800, 1800), Image.LANCZOS)
+            dst = os.path.join(OUT, f"{slug}-{kind}.webp")
+            im.save(dst, "WEBP", quality=90, method=6)
+            sizes[f"{slug}-{kind}"] = im.size
+            print(slug, kind, im.size)
+    json.dump(sizes, open(os.path.join(OUT, "pieces.json"), "w"), indent=1)
