+#!/usr/bin/env python3
+"""Generate the story-collage image library for the nine totems through Codex, two at a time.
+Skips anything already made, so it can be re-run to fill gaps.
+
+    python3 pdp/_variant-story/pdp/gen_library.py
+"""
+import os, subprocess, sys
+from concurrent.futures import ThreadPoolExecutor
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+O = os.path.join(HERE, "img", "story")
+GEN = os.path.join(O, "gen")
+M = os.path.join(HERE, "img", "moodboard", "museum")
+CODEX = os.path.expanduser("~/.claude/skills/codex-imagegen/scripts/gen.py")
+
+TOTEMS = {  # name; what lies beside it in the cyanotype (varied objects, from its story)
+    "pip": ("Pip", "a small old key, a single shirt button, a loose loop of thread and a sprig of lavender"),
+    "rebi": ("Rebi", "a four-leaf clover, a small coin, a loose loop of thread and a fern frond"),
+    "ren": ("Ren", "an oak leaf, an acorn, a small compass and a short twig"),
+    "zuma": ("Zuma", "a small spiral shell, a smooth pebble, a coil of string and a sprig of sage"),
+    "milo": ("Milo", "a wheat stalk, a small feather, a button and a length of twine"),
+    "yael": ("Yael", "a feather, a tiny bell, a short ribbon and a fern frond"),
+    "ori": ("Ori", "a maple leaf, an acorn, a small key and a pine twig"),
+    "ibi": ("Ibi", "a long feather, a slender reed, a scrap of lace and a small coin"),
+    "eleph": ("Eleph", "a ginkgo leaf, a loop of string, a small button and a pressed flower"),
+}
+PH = ("a Talbot photogenic drawing, a salted-paper negative from about 1840: warm brown, uneven, mottled sensitised paper "
+      "with soft darker edges and a few small specks, the object recorded as a pale cream trace by light alone.")
+
+
+def jobs():
+    for s, (name, things) in TOTEMS.items():
+        yield (f"{s}-cyano2.png", [f"{M}/aic-73448.jpg"],
+               "Make a new cyanotype in the same technique as the reference: deep Prussian blue with a soft, uneven, brushed and mottled "
+               "texture and tiny specks, crisp pale near-white contact-print traces. The blue print has its four corners CLIPPED (chamfered), "
